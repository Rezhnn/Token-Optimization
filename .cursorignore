# ==============================================================================
# .geminiignore - EXTREME FINOPS & CONTEXT OPTIMIZATION
# ==============================================================================

# 1. DEPENDENCY TREES & LOCK FILES (MASSIVE TOKEN DRAINS)
node_modules/
vendor/
packages/*/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
composer.lock
poetry.lock
Cargo.lock
Gemfile.lock
pubspec.lock
go.sum
mix.lock
Pipfile.lock

# 2. SYSTEM & IDE NOISE
.DS_Store
Thumbs.db
$RECYCLE.BIN/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln.docstates

# 3. BUILD ARTIFACTS & COMPILED CODE
dist/
build/
out/
target/
.next/
.nuxt/
.output/
.svelte-kit/
.serverless/
bin/
obj/
*.class
*.pyc
__pycache__/
*.so
*.dylib
*.dll
*.exe
*.o
*.a
*.lib

# 4. CACHES, METADATA & COVERAGE
.cache/
.vite/
.turbo/
.parcel-cache/
.eslintcache
.babel-cache/
.tsbuildinfo
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
.nyc_output/
.tox/

# 5. DATABASES & LOGS
*.log
*.sqlite
*.sqlite*
*.sqlite3
*.db
*.sql
*.sql.gz
*.pb
*.mongo
*.rdb
storage/logs/

# 6. BINARY, MULTIMEDIA & HEAVY ASSETS
# (Prevents expensive multimodal/vision token usage unless requested)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.psd
*.fig
*.mp4
*.mp3
*.wav
*.pdf
*.zip
*.tar.gz
*.rar
*.7z
*.woff
*.woff2
*.ttf
*.eot

# 7. MINIFIED & COMPILED WEB ASSETS
*.min.js
*.min.css
*.chunk.js
*.bundle.js
*.map

# 8. PYTHON VIRTUAL ENVIRONMENTS & PACKAGE ARTIFACTS
.venv/
venv/
env/
ENV/
.env/
site-packages/
pip-wheel-metadata/
.eggs/
*.egg-info/
*.pyd
