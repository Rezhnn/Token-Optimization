# 1. DEPENDENCY TREES & LOCK FILES
node_modules/
vendor/
packages/*/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
composer.lock
poetry.lock
Cargo.lock
Gemfile.lock
pubspec.lock
go.sum
mix.lock
Pipfile.lock

# 2. SYSTEM & IDE NOISE
.DS_Store
Thumbs.db
$RECYCLE.BIN/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json

# 3. PYTHON VIRTUAL ENVIRONMENTS & PACKAGE ARTIFACTS
.venv/
venv/
env/
ENV/
.env/
site-packages/
pip-wheel-metadata/
.eggs/
*.egg-info/
*.pyd

# 4. BUILD ARTIFACTS & COMPILED CODE
dist/
build/
out/
target/
.next/
.nuxt/
.output/
.svelte-kit/
.serverless/
bin/
obj/
*.class
*.pyc
__pycache__/
